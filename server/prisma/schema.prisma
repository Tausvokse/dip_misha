generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum ParkingSpotStatus {
  FREE
  LOCKED
  RESERVED
  MAINTENANCE
}

enum ReservationStatus {
  PENDING_PAYMENT
  RESERVED
  CANCELLED
  EXPIRED
  COMPLETED
}

enum PaymentMethodType {
  CARD
  APPLE_PAY
  GOOGLE_PAY
}

enum CardBrand {
  VISA
  MASTERCARD
}

model User {
  id             String          @id @default(uuid())
  email          String          @unique
  password_hash  String
  role           Role            @default(USER)
  profile        UserProfile?
  vehicles       Vehicle[]
  paymentMethods PaymentMethod[]
  reservations   Reservation[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model ParkingSpot {
  id           String            @id @default(uuid())
  number       String            @unique
  status       ParkingSpotStatus @default(FREE)
  reservations Reservation[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model UserProfile {
  id         String   @id @default(uuid())
  userId     String   @unique
  firstName  String?
  lastName   String?
  middleName String?
  phone      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Vehicle {
  id           String        @id @default(uuid())
  userId       String
  make         String
  model        String?
  licensePlate String
  color        String?
  isDefault    Boolean       @default(false)
  reservations Reservation[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, licensePlate])
  @@index([userId])
}

model PaymentMethod {
  id           String            @id @default(uuid())
  userId       String
  type         PaymentMethodType
  label        String
  brand        CardBrand?
  last4        String?
  isDefault    Boolean           @default(false)
  reservations Reservation[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Reservation {
  id            String            @id @default(uuid())
  userId        String
  spotId        String
  vehicleId     String?
  paymentMethodId String?
  startTime     DateTime
  endTime       DateTime
  status        ReservationStatus @default(PENDING_PAYMENT)
  totalPrice    Decimal           @db.Decimal(10, 2)
  lockExpiresAt DateTime?
  paidAt        DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  spot          ParkingSpot    @relation(fields: [spotId], references: [id], onDelete: Restrict)
  vehicle       Vehicle?       @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  paymentMethod PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([spotId, status])
  @@index([vehicleId])
  @@index([paymentMethodId])
  @@index([startTime, endTime])
  @@index([lockExpiresAt])
}
